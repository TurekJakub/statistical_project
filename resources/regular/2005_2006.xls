<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:x="urn:schemas-microsoft-com:office:excel" xmlns="http://www.w3.org/TR/REC-html40"><head><!--[if gte mso 9]><xml><x:ExcelWorkbook><x:ExcelWorksheets><x:ExcelWorksheet><x:Name>Worksheet</x:Name><x:WorksheetOptions><x:DisplayGridlines/></x:WorksheetOptions></x:ExcelWorksheet></x:ExcelWorksheets></x:ExcelWorkbook></xml><![endif]--></head><body><table>
    
    

   
   <thead>

      
      <tr class="over_header">
         <th aria-label="" data-stat="" colspan="7" class=" over_header center"></th><th></th><th></th><th></th><th></th>
         <th aria-label="" data-stat="" colspan="4" class=" over_header center"></th>
         <th aria-label="" data-stat="per_game" colspan="2" class=" over_header center">Per_game</th>
         <th aria-label="" data-stat="header_special_teams" colspan="10" class=" over_header center">Special Teams</th>
         <th aria-label="" data-stat="header_shot_data" colspan="4" class=" over_header center">Shot Data</th><th></th>
      </tr>
            
      <tr>
         <th aria-label="Rk" data-stat="ranker" scope="col" class="ranker poptip sort_default_asc show_partial_when_sorting center" data-tip="Rank">Rk</th>
         <th aria-label=" " data-stat="team_name" scope="col" class=" poptip sort_default_asc left"></th>
         <th aria-label="AvAge" data-stat="average_age" scope="col" class=" poptip center" data-tip="Average age of team weighted by time on ice.">AvAge</th>
         <th aria-label="GP" data-stat="games" scope="col" class=" poptip center" data-tip="Games Played">GP</th>
         <th aria-label="W" data-stat="wins" scope="col" class=" poptip center" data-tip="Wins">W</th>
         <th aria-label="L" data-stat="losses" scope="col" class=" poptip center" data-tip="Losses">L</th>
         <th aria-label="OL" data-stat="losses_ot" scope="col" class=" poptip center" data-tip="Overtime/Shootout Losses (2000 season onward)">OL</th>
         <th aria-label="PTS" data-stat="points" scope="col" class=" poptip center" data-tip="Points" data-over-header="Scoring">PTS</th>
         <th aria-label="PTS%" data-stat="points_pct" scope="col" class=" poptip center" data-tip="Points percentage (i.e., points divided by maximum points)">PTS%</th>
         <th aria-label="GF" data-stat="goals" scope="col" class=" poptip center" data-tip="Goals For" data-over-header="Scoring">GF</th>
         <th aria-label="GA" data-stat="goals_against" scope="col" class=" poptip center" data-tip="Goals Against" data-over-header="Goalie Stats">GA</th>
         <th aria-label="SOW" data-stat="wins_shootout" scope="col" class=" poptip center" data-tip="Shootout Wins">SOW</th>
         <th aria-label="SOL" data-stat="losses_shootout" scope="col" class=" poptip center" data-tip="Shootout Losses">SOL</th>
         <th aria-label="SRS" data-stat="srs" scope="col" class=" poptip center" data-tip="Simple Rating System; a team rating that takes into account average goal differential and strength of schedule. The rating is denominated in goals above/below average, where zero is average.">SRS</th>
         <th aria-label="SOS" data-stat="sos" scope="col" class=" poptip center" data-tip="Strength of Schedule; a rating of strength of schedule. The rating is denominated in goals above/below average, where zero is average.">SOS</th>
         <th aria-label="GF/G" data-stat="goals_for_per_game" scope="col" class=" poptip center" data-tip="Goals For Per Game">GF/G</th>
         <th aria-label="GA/G" data-stat="goals_against_per_game" scope="col" class=" poptip center" data-tip="Goals Against Per Game">GA/G</th>
         <th aria-label="PP" data-stat="goals_pp" scope="col" class=" poptip center" data-tip="Power Play Goals" data-over-header="Special Teams">PP</th>
         <th aria-label="PPO" data-stat="chances_pp" scope="col" class=" poptip center" data-tip="Power Play Opportunities" data-over-header="Special Teams">PPO</th>
         <th aria-label="PP%" data-stat="power_play_pct" scope="col" class=" poptip center" data-tip="Power Play Percentage" data-over-header="Special Teams">PP%</th>
         <th aria-label="PPA" data-stat="opp_goals_pp" scope="col" class=" poptip center" data-tip="Power Play Goals Against" data-over-header="Special Teams">PPA</th>
         <th aria-label="PPOA" data-stat="opp_chances_pp" scope="col" class=" poptip center" data-tip="Power Play Opportunities Against" data-over-header="Special Teams">PPOA</th>
         <th aria-label="PK%" data-stat="pen_kill_pct" scope="col" class=" poptip center" data-tip="Penalty Killing Percentage" data-over-header="Special Teams">PK%</th>
         <th aria-label="SH" data-stat="goals_sh" scope="col" class=" poptip center" data-tip="Short-Handed Goals" data-over-header="Special Teams">SH</th>
         <th aria-label="SHA" data-stat="opp_goals_sh" scope="col" class=" poptip center" data-tip="Short-Handed Goals Against" data-over-header="Special Teams">SHA</th>
         <th aria-label="PIM/G" data-stat="pen_min_per_game" scope="col" class=" poptip center" data-tip="Penalties in Minutes Per Game" data-over-header="Special Teams">PIM/G</th>
         <th aria-label="oPIM/G" data-stat="pen_min_per_game_opp" scope="col" class=" poptip center" data-tip="Opponent Penalties in Minutes Per Game" data-over-header="Special Teams">oPIM/G</th>
         <th aria-label="S" data-stat="shots" scope="col" class=" poptip center" data-tip="Shots on Goal" data-over-header="Shot Data">S</th>
         <th aria-label="S%" data-stat="shot_pct" scope="col" class=" poptip center" data-tip="Shooting Percentage" data-over-header="Shot Data">S%</th>
         <th aria-label="SA" data-stat="shots_against" scope="col" class=" poptip center" data-tip="Shots Against" data-over-header="Shot Data">SA</th>
         <th aria-label="SV%" data-stat="save_pct" scope="col" class=" poptip center" data-tip="Save Percentage" data-over-header="Shot Data">SV%</th>
         <th aria-label="SO" data-stat="shutouts" scope="col" class=" poptip center" data-tip="Shutouts" data-over-header="Goalie Stats">SO</th>
      </tr>
      </thead>
